# Hybrid Autorouter Configuration
PORT=20250
HOST=127.0.0.1
LOG_LEVEL=info
ROUTING_CONFIG_PATH=config/9router-production.yaml

# Upstream 9Router
ANTIGRAVITY_BASE_URL=http://127.0.0.1:20128/v1
ANTIGRAVITY_API_KEY=

# Verified Antigravity model IDs from local 9Router instance
OPUS_4_6_MODEL_ID=ag/claude-opus-4-6-thinking
SONNET_4_6_MODEL_ID=ag/claude-sonnet-4-6
GEMINI_3_1_PRO_MODEL_ID=ag/gemini-3.1-pro-low
GEMINI_3_8_FLASH_MODEL_ID=ag/gemini-3.8-flash

# Concurrency & Quota ceilings (from Antigravity Quota Tracker)
OPUS_RPM=60
OPUS_TPM=1000000
PRO_RPM=120
PRO_TPM=2000000
FLASH_RPM=300
FLASH_TPM=4000000
